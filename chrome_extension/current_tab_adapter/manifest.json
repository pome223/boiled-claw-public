{
  "manifest_version": 3,
  "name": "boiled-claw Current Tab Adapter",
  "version": "0.1.0",
  "description": "Relays the active Chrome tab to boiled-claw over a local WebSocket.",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "minimum_chrome_version": "116"
}
