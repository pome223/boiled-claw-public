# =============================================================================
# boiled-claw 設定サンプル
# このファイルを .env にコピーして値を埋めてください。
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Google AI / ADK（必須）
# https://aistudio.google.com/apikey で取得
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here
# Vertex AI を使う場合は true（通常は false のまま）
GOOGLE_GENAI_USE_VERTEXAI=false

# -----------------------------------------------------------------------------
# エージェント設定
# -----------------------------------------------------------------------------
AGENT_NAME=boiled-claw
# 使用するモデル。利用可能な Gemini モデル名を指定
AGENT_MODEL=gemini-3-flash-preview

# -----------------------------------------------------------------------------
# ゲートウェイ（WebSocket サーバー）
# -----------------------------------------------------------------------------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=18789
GATEWAY_WS_PATH=/ws
# API 認証キー。空のままにすると認証なし（ローカル開発のみ推奨）
# Docker 公開やリモートアクセス時は必ず設定すること。
GATEWAY_API_KEY=
# 認証済み user_id を信頼するヘッダ名（例: X-Auth-User）
# 設定した場合、Gateway はこのヘッダを effective user_id として使う。
# 未設定のまま GATEWAY_API_KEY を使うと、認証済みリクエストは単一 principal に束ねられる。
GATEWAY_AUTH_USER_HEADER=

# -----------------------------------------------------------------------------
# チャンネル統合（任意）
# 使用するチャンネルのトークンだけ設定し、不要なものは空のまま
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# -----------------------------------------------------------------------------
# メモリ（ベクトル検索付き SQLite）
# -----------------------------------------------------------------------------
MEMORY_DB_PATH=data/memory.db
# 埋め込みベクトルの次元数（gemini-embedding-001 は 768）
MEMORY_VECTOR_DIM=768
# 埋め込みモデル。Google AI では gemini-embedding-001 を使用
MEMORY_EMBEDDING_MODEL=gemini-embedding-001

# -----------------------------------------------------------------------------
# セキュリティ
# -----------------------------------------------------------------------------
AUDIT_LOG_PATH=data/audit.log
# シェルコマンド実行を許可するか
SHELL_ENABLED=true
# ファイル操作を許可するディレクトリ（カンマ区切り）
# 空のままにするとブロックリストのみ（ホワイトリストなし）
# Docker 運用時は /app/data,/app/skills を推奨
FILE_WORKSPACE_PATHS=

# -----------------------------------------------------------------------------
# サブエージェント制御
# -----------------------------------------------------------------------------
# グローバルの同時実行上限（全セッション合計）
SUBAGENT_MAX_CONCURRENT=8
# 1 セッションあたりの同時実行上限
SUBAGENT_MAX_PER_SESSION=5
# スポーン深度の上限（root agent=0, 直接 spawn=1, ネスト spawn=2 ...）
# 無限ループ防止のために 1〜3 を推奨。増やすほどリスクが上がる。
SUBAGENT_MAX_SPAWN_DEPTH=2

# -----------------------------------------------------------------------------
# ブラウザ自動化（Playwright）
# -----------------------------------------------------------------------------
# ヘッドレスモードで実行するか（Docker では true 必須）
BROWSER_HEADLESS=true
# ページ読み込みタイムアウト（ミリ秒）
BROWSER_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Redis（任意 - 分散セッション用。現在は未使用）
# -----------------------------------------------------------------------------
REDIS_URL=
