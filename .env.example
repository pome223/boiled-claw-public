# Google AI / ADK
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=false

# Agent settings
AGENT_NAME=boiled-claw
AGENT_MODEL=gemini-3-flash-preview

# Gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=18789
GATEWAY_WS_PATH=/ws

# Channels (optional)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Memory
MEMORY_DB_PATH=data/memory.db
MEMORY_VECTOR_DIM=768
MEMORY_EMBEDDING_MODEL=text-embedding-004

# Security
AUDIT_LOG_PATH=data/audit.log
SHELL_ENABLED=true
# API key for gateway auth. Leave empty to disable auth (local dev only).
GATEWAY_API_KEY=

# Redis (optional - for distributed sessions)
REDIS_URL=

# Browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000
